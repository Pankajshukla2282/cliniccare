# ClinicCare local development template. Copy to .env and edit.
NODE_ENV=development
APP_ENV=development
DEV_INFRA_MODE=auto
DEPLOYMENT_NAMESPACE=cliniccare-development
APP_NAME=ClinicCare
TENANT_BASE_DOMAIN=localhost
TENANT_QUERY_PARAM=tenant
DEFAULT_TENANT_SLUG=cliniccare-demo

API_HOST=127.0.0.1
API_PORT=3100
API_BASE_PATH=/api/v1
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:3000
WEB_HOST=127.0.0.1
WEB_PORT=3000

DATABASE_URL=postgresql://cliniccare:change-me@localhost:5432/cliniccare
POSTGRES_USER=cliniccare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cliniccare
REDIS_PASSWORD=change-me-to-a-random-password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=12

CORS_ALLOW_CREDENTIALS=true
CSRF_ENABLED=false
CSRF_ALLOWED_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=info
LOG_DIR=./logs
PHI_NO_STORE=true
IDEMPOTENCY_TTL_MINUTES=30
ENABLE_SWAGGER=true
SWAGGER_PATH=docs
API_VERSION=1

# Kubernetes is optional in local development.
K8S_NAMESPACE=cliniccare-development
POSTGRES_SERVICE=postgres
POSTGRES_LOCAL_PORT=5432
WEB_HEALTH_PATH=/healthz

# Seed controls. Use explicit values for staging/production demo databases.
SEED_TENANT_SLUG=cliniccare-demo
SEED_SECOND_TENANT_SLUG=cliniccare-demo-wellness
SEED_ALLOW_DEMO=false
SEED_ADMIN_EMAIL=admin@cliniccare.local
SEED_SUPER_ADMIN_EMAIL=superadmin@cliniccare.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
SEED_DOCTOR_PASSWORD=Doctor123!
SEED_RECEPTION_PASSWORD=Reception123!
SEED_PATIENT_PASSWORD=Patient123!
