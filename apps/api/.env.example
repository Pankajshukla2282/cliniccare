NODE_ENV=development
APP_ENV=development
DEPLOYMENT_NAMESPACE=cliniccare-dev
APP_NAME=ClinicCare API

API_HOST=127.0.0.1
API_PORT=3100
API_BASE_PATH=/api/v1
WEB_ORIGIN=http://127.0.0.1:3000

DATABASE_URL=postgresql://cliniccare:change-me@localhost:5432/cliniccare
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=12

CORS_ALLOW_CREDENTIALS=true
CSRF_ENABLED=false
CSRF_ALLOWED_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
LOG_DIR=./logs
PHI_NO_STORE=true
IDEMPOTENCY_TTL_MINUTES=30
ENABLE_SWAGGER=true
SWAGGER_PATH=docs
API_VERSION=1
