NODE_ENV=development
APP_ENV=development
DEPLOYMENT_NAMESPACE=cliniccare-development
APP_NAME=ClinicCare Web

WEB_HOST=127.0.0.1
WEB_PORT=3000
API_URL=http://127.0.0.1:3100

TENANT_BASE_DOMAIN=localhost
TENANT_QUERY_PARAM=tenant
DEFAULT_TENANT_SLUG=cliniccare-demo

# Browser-safe values only.
NEXT_PUBLIC_APP_NAME=ClinicCare
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://127.0.0.1:3100
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_TENANT_BASE_DOMAIN=localhost
NEXT_PUBLIC_TENANT_QUERY_PARAM=tenant
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=cliniccare-demo
