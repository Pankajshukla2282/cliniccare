# Production secrets must come from AWS Secrets Manager/SSM or the deployment secret store.
APP_ENV=production
NODE_ENV=production
DEPLOYMENT_NAMESPACE=cliniccare-production
API_URL=https://api.example.com
WEB_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com
DEFAULT_TENANT_SLUG=cliniccare
ENABLE_SWAGGER=false
LOG_LEVEL=warn
DOCUMENT_STORAGE=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=cliniccare-production-documents
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
