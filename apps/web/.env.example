# ClinicCare Web environment template
# Only NEXT_PUBLIC_* values are exposed to browser code.
NODE_ENV=development
APP_ENV=development
DEPLOYMENT_NAMESPACE=cliniccare-dev
TENANT_BASE_DOMAIN=localhost
APP_NAME=ClinicCare

WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_URL=http://localhost:3000

API_URL=http://localhost:3100
API_PREFIX=api/v1

TENANT_QUERY_PARAM=tenant
DEFAULT_TENANT_SLUG=default

LOG_LEVEL=info
LOG_DIR=./logs

# Browser-safe values only:
NEXT_PUBLIC_APP_NAME=ClinicCare
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_API_PREFIX=api/v1
NEXT_PUBLIC_TENANT_BASE_DOMAIN=localhost
NEXT_PUBLIC_TENANT_QUERY_PARAM=tenant
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=default
