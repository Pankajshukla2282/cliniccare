# # ClinicCare production environment template
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cliniccare
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT_EXPIRES_IN=15m
# BCRYPT_SALT_ROUNDS=12
# CORS_ORIGIN=http://localhost:3100
# TRUST_PROXY=1
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# NEXT_PUBLIC_API_URL=https://api.example.com
# REDIS_PASSWORD=replace-with-a-long-random-redis-password
# LOG_DIR=logs



# # ClinicCare local environment. Do NOT commit real values.
# # Copy .env.example to .env for the full, documented key list.

# # Postgres (used by the postgres container, seed, prisma CLI, and app)
# POSTGRES_DB=cliniccare
# POSTGRES_USER=clinic
# POSTGRES_PASSWORD=JWbD4wxpHI7tmGMwtnhb6hwt

# # Local dev connection (localhost via kubectl port-forward)
# DATABASE_URL=postgresql://clinic:JWbD4wxpHI7tmGMwtnhb6hwt@localhost:5432/cliniccare

# # API auth
# JWT_SECRET=mbVXegYo0MC54xaGfLZyVJ4NGsitgQl3eS1Di9WoXEHeHKgi

# # Rate limiting + proxy (set TRUST_PROXY=1 when behind the ingress/LB)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# TRUST_PROXY=0

# # Next.js public API URL
# NEXT_PUBLIC_API_URL=https://api.example.com

# # Seed accounts (used when SEED_* vars are absent they fall back to these)
# SEED_ADMIN_EMAIL=admin@cliniccare.local
# SEED_ADMIN_PASSWORD=@AwqZSm7trzTRHSs
# SEED_SUPER_ADMIN_EMAIL=superadmin@cliniccare.local
# SEED_SUPER_ADMIN_PASSWORD=#zyiiybUvC2HmX2SDW68

# # External provider credentials (placeholders for now)
# RAZORPAY_KEY_ID=CHANGE_ME
# RAZORPAY_KEY_SECRET=CHANGE_ME
# SMS_API_KEY=CHANGE_ME
# SMS_API_SECRET=CHANGE_ME
# WHATSAPP_TOKEN=CHANGE_ME
# EMAIL_SMTP_HOST=CHANGE_ME
# EMAIL_SMTP_USER=CHANGE_ME
# EMAIL_SMTP_PASSWORD=CHANGE_ME
# AWS_ACCESS_KEY_ID=CHANGE_ME
