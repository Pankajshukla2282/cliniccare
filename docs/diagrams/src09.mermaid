flowchart TD
  SA["SUPER_ADMIN<br/>global, all scopes"]
  CA["CLINIC_ADMIN<br/>org-wide"]
  AD["ADMIN"]
  DR["DOCTOR"]
  NUR["NURSE"]
  RC["RECEPTIONIST"]
  PH["PHARMACIST"]
  AC["ACCOUNTANT"]
  CM["CONTENT_MANAGER"]
  PT["PATIENT"]

  SA --> CA
  CA --> AD
  AD --> DR
  AD --> NUR
  AD --> RC
  AD --> PH
  AD --> AC
  AD --> CM
  AD --> PT

  DR -.->|"medical_record.write, prescription.*"|PT
  PH -.->|"inventory.*, orders"|PT
  RC -.->|"appointment.*, patient.read"|PT
  AC -.->|"billing.*, report.view"|PT
  CM -.->|"cms.*"|PT