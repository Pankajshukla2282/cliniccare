# ClinicCare scripts environment template
NODE_ENV=development
APP_ENV=development

API_URL=http://localhost:3100
API_PREFIX=api/v1
API_HEALTH_PATH=/healthz

WEB_URL=http://localhost:3000
WEB_HEALTH_PATH=/

API_HOST=127.0.0.1
API_PORT=3100
WEB_HOST=127.0.0.1
WEB_PORT=3000

POSTGRES_LOCAL_PORT=5432
REDIS_LOCAL_PORT=6379

K8S_NAMESPACE=cliniccare
POSTGRES_SERVICE=postgres
REDIS_SERVICE=redis

SMOKE_TEST_TENANT=default
SMOKE_TEST_USER_EMAIL=admin@example.com
SMOKE_TEST_USER_PASSWORD=CHANGE_ME
