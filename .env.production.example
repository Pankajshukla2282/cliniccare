# Production overlay example
# Supply secrets through AWS Secrets Manager / SSM or your deployment secret store.
APP_ENV=production
DEPLOYMENT_NAMESPACE=cliniccare-prod
TENANT_BASE_DOMAIN=cliniccare.example.com
NODE_ENV=production
API_URL=https://api.example.com
WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
CSRF_ORIGINS=https://app.example.com
SWAGGER_ENABLED=false
LOG_LEVEL=warn
DOCUMENT_STORAGE=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=cliniccare-production-documents
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
