{
  "name": "cliniccare",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "typecheck:api": "npm run db:generate && tsc -p apps/api/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:auth": "tsc -p apps/auth/tsconfig.json --noEmit",
    "typecheck:clinical": "tsc -p apps/clinical/tsconfig.json --noEmit",
    "typecheck:billing": "tsc -p apps/billing/tsconfig.json --noEmit",
    "typecheck:product": "tsc -p apps/product/tsconfig.json --noEmit",
    "typecheck:queue": "tsc -p apps/queue/tsconfig.json --noEmit",
    "typecheck:lab": "tsc -p apps/lab/tsconfig.json --noEmit",
    "typecheck:cms": "tsc -p apps/cms/tsconfig.json --noEmit",
    "build:api": "npm run build --workspace=@cliniccare/api",
    "build:web": "npm run build --workspace=@cliniccare/web",
    "build:auth": "npm run build --workspace=@cliniccare/auth",
    "build:clinical": "npm run build --workspace=@cliniccare/clinical",
    "build:billing": "npm run build --workspace=@cliniccare/billing",
    "build:product": "npm run build --workspace=@cliniccare/product",
    "build:queue": "npm run build --workspace=@cliniccare/queue",
    "build:lab": "npm run build --workspace=@cliniccare/lab",
    "build:cms": "npm run build --workspace=@cliniccare/cms",
    "build:all": "npm run db:generate && npm run build:api && npm run build:web && npm run build:auth && npm run build:clinical && npm run build:billing && npm run build:product && npm run build:queue && npm run build:lab && npm run build:cms",
    "lint:api": "eslint \"apps/api/src/**/*.ts\"",
    "lint:web": "eslint \"apps/web/**/*.{ts,tsx,js,mjs}\"",
    "lint:auth": "eslint \"apps/auth/src/**/*.ts\"",
    "lint:clinical": "eslint \"apps/clinical/src/**/*.ts\"",
    "lint:billing": "eslint \"apps/billing/src/**/*.ts\"",
    "lint:product": "eslint \"apps/product/src/**/*.ts\"",
    "lint:queue": "eslint \"apps/queue/src/**/*.ts\"",
    "lint:lab": "eslint \"apps/lab/src/**/*.ts\"",
    "lint:cms": "eslint \"apps/cms/src/**/*.ts\"",
    "lint": "npm run lint:api && npm run lint:web && npm run lint:auth && npm run lint:clinical && npm run lint:billing && npm run lint:product && npm run lint:queue && npm run lint:lab && npm run lint:cms",
    "security:audit": "npm audit --audit-level=high",
    "test:security": "npm run typecheck:api && npm run typecheck:web && npm run typecheck:auth && npm run typecheck:clinical && npm run typecheck:billing && npm run typecheck:product && npm run typecheck:queue && npm run typecheck:lab && npm run typecheck:cms && npm run security:audit",
    "baseline:verify": "node scripts/verify-production-baseline.mjs",
    "dev:api": "npm run dev --workspace=@cliniccare/api",
    "dev:web": "npm run dev --workspace=@cliniccare/web",
    "dev:auth": "npm run dev --workspace=@cliniccare/auth",
    "dev:clinical": "npm run dev --workspace=@cliniccare/clinical",
    "dev:billing": "npm run dev --workspace=@cliniccare/billing",
    "dev:product": "npm run dev --workspace=@cliniccare/product",
    "dev:queue": "npm run dev --workspace=@cliniccare/queue",
    "dev:lab": "npm run dev --workspace=@cliniccare/lab",
    "dev:cms": "npm run dev --workspace=@cliniccare/cms",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:api": "node --import tsx --test \"tests/api/**/*.test.ts\"",
    "test:auth": "node --import tsx --test \"tests/auth/**/*.test.ts\"",
    "format:check": "npx prettier --check \"apps/**/*.{ts,tsx,js,mjs,json}\" \"prisma/**/*.{prisma,ts}\"",
    "ci": "npm run prisma:validate && npm run typecheck:api && npm run typecheck:web && npm run typecheck:auth && npm run typecheck:clinical && npm run typecheck:billing && npm run typecheck:product && npm run typecheck:queue && npm run typecheck:lab && npm run typecheck:cms && npm run security:audit && npm run lint",
    "production:verify": "npm run ci && npm run baseline:verify",
    "test:e2e:workflow": "node scripts/smoke-workflow.mjs",
    "start:unix": "bash scripts/start.sh",
    "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "^4.19.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.21.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1"
}