# ClinicCare root environment template
# Copy to .env for local development. Never commit real .env files.

NODE_ENV=development
DEV_INFRA_MODE=auto
APP_ENV=development
DEPLOYMENT_NAMESPACE=cliniccare-dev
TENANT_BASE_DOMAIN=localhost
APP_NAME=ClinicCare

API_HOST=0.0.0.0
API_PORT=3100
API_PREFIX=api/v1
API_URL=http://localhost:3100

WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_URL=http://localhost:3000

DATABASE_URL=postgresql://cliniccare:change-me@localhost:5432/cliniccare
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
JWT_ISSUER=cliniccare
JWT_AUDIENCE=cliniccare-api

PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

CSRF_ENABLED=true
CSRF_ORIGINS=http://localhost:3000
TRUST_PROXY=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

LOG_LEVEL=info
LOG_DIR=./logs
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

TENANT_QUERY_PARAM=tenant
DEFAULT_TENANT_SLUG=default

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

DOCUMENT_STORAGE=local
DOCUMENT_MAX_SIZE_MB=25
DOCUMENT_LOCAL_PATH=./storage/documents

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_DOCUMENT_PREFIX=documents/

EMAIL_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

PAYMENT_PROVIDER=
PAYMENT_API_URL=
PAYMENT_API_KEY=

QUEUE_TOKEN_PREFIX=TK
QUEUE_TOKEN_DIGITS=4

JOBS_ENABLED=true
JOB_TIMEZONE=Asia/Kolkata

HEALTH_ENABLED=true
METRICS_ENABLED=false
